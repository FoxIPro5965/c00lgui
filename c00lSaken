local function onCharacterAdded(newChar)
	local hum = newChar:WaitForChild("Humanoid", 10)
	local hrp = newChar:WaitForChild("HumanoidRootPart", 10)
	if not hum or not hrp then return end

	task.defer(function()
		if infEnabled then
			stamina.StaminaLossDisabled = true
			stamina.Stamina = stamina.MaxStamina
		end
		local speedVal = tonumber(speedBox.Text)
		if speedVal then
			stamina.SprintSpeed = speedVal
		end
	end)

	if _G.AutoBlockEnabled then
		task.defer(function()
			task.wait(0.8)
			DisableAutoBlock()
			GetObjects()
			EnableAutoBlock()
		end)
	end

	if _G.AimPunchEnabled then
		toggleModule("Punch", false)
		task.wait(0.1)
		toggleModule("Punch", true)
	end

	if voidrushcontrol then
		stopOverride()
	end
end

