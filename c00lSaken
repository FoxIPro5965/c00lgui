local function SolveNow()
	if currentPuzzle then
		flowSolve(currentPuzzle)
	else
		for _, v in pairs(getgc(true)) do
			if typeof(v) == "table" and rawget(v, "Solution") and rawget(v, "paths") and rawget(v, "updateGui") then
				flowSolve(v)
				break
			end
		end
	end
end

