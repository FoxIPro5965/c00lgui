local function ToggleHakariDance(state)
	local char = LP.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end
	if state then
		hakariActive = true
		humanoid.PlatformStand = true
		humanoid.JumpPower = 0
		local bv = Instance.new("BodyVelocity")
		bv.Name = "HakariBV"
		bv.MaxForce = Vector3.new(1e5,1e5,1e5)
		bv.Velocity = Vector3.zero
		bv.Parent = rootPart
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://138019937280193"
		local track = humanoid:LoadAnimation(anim)
		track:Play()
		local sound = Instance.new("Sound")
		sound.Name = "HakariSound"
		sound.SoundId = "rbxassetid://87166578676888"
		sound.Volume = 0.5
		sound.Looped = true
		sound.Parent = rootPart
		sound:Play()
		pcall(function()
			local effect = ReplicatedStorage.Assets.Emotes.HakariDance.HakariBeamEffect:Clone()
			effect.Name = "PlayerEmoteVFX"
			effect.CFrame = char.PrimaryPart.CFrame * CFrame.new(0,-1,-0.3)
			effect.WeldConstraint.Part0 = char.PrimaryPart
			effect.WeldConstraint.Part1 = effect
			effect.Parent = char
			effect.CanCollide = false
		end)
		pcall(function()
			ReplicatedStorage.Modules.Network.RemoteEvent:FireServer("PlayEmote", "Animations", "HakariDance")
		end)
		track.Stopped:Connect(function()
			if not hakariActive then
				humanoid.PlatformStand = false
				local b = rootPart:FindFirstChild("HakariBV")
				if b then b:Destroy() end
			end
		end)
	else
		hakariActive = false
		humanoid.PlatformStand = false
		humanoid.JumpPower = 50
		local b = rootPart:FindFirstChild("HakariBV")
		if b then b:Destroy() end
		local s = rootPart:FindFirstChild("HakariSound")
		if s then s:Stop() s:Destroy() end
		local e = char:FindFirstChild("PlayerEmoteVFX")
		if e then e:Destroy() end
		for _, t in ipairs(humanoid:GetPlayingAnimationTracks()) do
			if t.Animation.AnimationId == "rbxassetid://138019937280193" then t:Stop() end
		end
	end
end

-- Key Input
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if waitingForKey then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			hakariKey = input.KeyCode
			keyButton.Text = "Hakari Key: " .. input.KeyCode.Name
			waitingForKey = false
			SaveConfig()
		end
		return
	end
	if waitingForSolveKey then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			solveKey = input.KeyCode
			solveKeyBtn.Text = "Solve Key: " .. input.KeyCode.Name
			waitingForSolveKey = false
			SaveConfig()
		end
		return
	end
	if input.KeyCode == Enum.KeyCode.K then ToggleGUI()
	elseif input.KeyCode == Enum.KeyCode.KeypadFour then PrevPage()
	elseif input.KeyCode == Enum.KeyCode.KeypadSix then NextPage()
	elseif input.KeyCode == hakariKey then ToggleHakariDance(not hakariActive)
	elseif input.KeyCode == solveKey then SolveNow() end
end)

-- Drag Logic
local function MakeDrag(frame)
	local drag, start, pos
	frame.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = true start = i.Position pos = frame.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then drag = false end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - start
			frame.Position = UDim2.new(pos.X.Scale, pos.X.Offset + d.X, pos.Y.Scale, pos.Y.Offset + d.Y)
		end
	end)
end
MakeDrag(main)
MakeDrag(mini)

